<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>SV.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Mesmas versões do desktop (SistemaVendas.csproj), para o banco ter o mesmo comportamento. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.6" />
    <!-- 2.1.14: versões até 2.1.11 têm a vulnerabilidade GHSA-2m69-gcr7-jv3q (NU1903). -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.14" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- Mesmo arquivo do desktop: a camada SQLite não é copiada. -->
    <Compile Include="..\SistemaVendas\Database.cs" Link="Compartilhado\Database.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- O servidor serve o mesmo frontend do desktop (http://IP:5080/), copiado para a pasta frontend ao lado do exe.
         Não usar o nome wwwroot: o SDK do ASP.NET Core trataria como static web assets e falharia. Fotos locais (images) ficam de fora. -->
    <Content Include="..\SistemaVendas\frontend\**\*"
             Exclude="..\SistemaVendas\frontend\images\**"
             Link="frontend\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
